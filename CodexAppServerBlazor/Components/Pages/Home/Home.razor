@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@using CodexAppServerBlazor.Services.Workflow

<PageTitle>Coding Services</PageTitle>

<section class="control-screen">
    <header class="command-bar">
        <div class="title-strip">
            <div class="brand-lockup">
                <img style="height:40px; width:auto;" src="/images/cs_header_logo_56x40.svg" alt="Coding Services" />                <h1>Coding Services</h1>
            </div>
        </div>
        <div class="command-bar-actions">
            <div class="run-started-at">Run Started At : @runStartedAtDisplay</div>
            <RadzenButton Icon="settings"
                          Text="Connection"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@ToggleConnectionPanel" />
        </div>
    </header>

    <main class="control-grid" @ref="controlGrid">
        <section class="work-panel" @ref="workPanel">
            <div class="workspace-toolbar">
                <div class="workspace-path">
                    <strong>@repoRoot</strong>
                </div>
                <div class="workspace-state">
                    <span class="workspace-state-text">@(snapshot.IsServerStarted ? "Running" : "Stopped")</span>
                    @if (snapshot.IsTurnRunning)
                    {
                        <span class="workspace-state-divider" aria-hidden="true">•</span>
                        <span class="workspace-state-text workspace-state-text-live">
                            <span class="workspace-state-spinner" aria-hidden="true"></span>
                            <span>Thinking</span>
                        </span>
                    }
                </div>
                <RadzenButton Icon="folder_open"
                              Text="Browse"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Small"
                              Click="@BrowseForDirectory"
                              Disabled="@busy" />
            </div>

            @if (isDirectoryBrowserVisible)
            {
                <section class="directory-picker-panel">
                    <div class="directory-picker-header">
                        <div class="directory-picker-title">
                            <span>Choose CWD</span>
                            <strong>@directorySnapshot.CurrentPath</strong>
                        </div>
                        <div class="directory-picker-actions">
                            <RadzenButton Icon="check"
                                          Text="Use This Folder"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small"
                                          Click="@UseBrowsedDirectory" />
                            <RadzenButton Icon="close"
                                          Text="Cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@CancelDirectoryBrowser" />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(directorySnapshot.ErrorMessage))
                    {
                        <div class="inline-error">@directorySnapshot.ErrorMessage</div>
                    }

                    <div class="directory-picker-grid">
                        <div class="directory-picker-section">
                            <div class="directory-picker-label">Drives</div>
                            <div class="directory-picker-list">
                                @foreach (DirectoryEntryViewModel drive in directorySnapshot.Drives)
                                {
                                    <button type="button" class="directory-picker-row" @onclick="() => BrowseToDirectory(drive.FullPath)">
                                        <span class="directory-picker-icon">DRV</span>
                                        <span>@drive.Name</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="directory-picker-section">
                            <div class="directory-picker-label">Folders</div>
                            <div class="directory-picker-list">
                                @if (!string.IsNullOrWhiteSpace(directorySnapshot.ParentPath))
                                {
                                    <button type="button" class="directory-picker-row" @onclick="() => BrowseToDirectory(directorySnapshot.ParentPath!)">
                                        <span class="directory-picker-icon">UP</span>
                                        <span>Parent</span>
                                    </button>
                                }

                                @foreach (DirectoryEntryViewModel child in directorySnapshot.Children)
                                {
                                    <button type="button" class="directory-picker-row" @onclick="() => BrowseToDirectory(child.FullPath)">
                                        <span class="directory-picker-icon">DIR</span>
                                        <span>@child.Name</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(directorySnapshot.ErrorMessage))
            {
                <div class="inline-error">@directorySnapshot.ErrorMessage</div>
            }

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Tasks">
                        <TasksTab @key="repoRoot" WorkspaceRoot="@repoRoot" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Assistant">
                        <AssistantTab @key="assistantViewKey"
                                      TranscriptHtml="@TranscriptHtml"
                                      TranscriptBodyHtml="@TranscriptBodyHtml"
                                      TranscriptText="@TranscriptText"
                                      CurrentTurnHtml="@CurrentTurnHtml"
                                      TurnMode="@turnMode"
                                      TurnModeChanged="@ChangeAssistantTurnMode"
                                      AutoApproveTrustedMcpToolRequests="@autoApproveTrustedMcpToolRequests"
                                      AutoApproveTrustedMcpToolRequestsChanged="@SetAutoApproveTrustedMcpToolRequests"
                                      PermissionRequests="@snapshot.PermissionRequests"
                                      Attachments="@turnAttachments"
                                      AttachmentPickerKey="@attachmentPickerKey"
                                      @bind-ChatDraft="@chatDraft"
                                      IsServerStarted="@snapshot.IsServerStarted"
                                      IsTurnRunning="@snapshot.IsTurnRunning"
                                      Busy="@busy"
                                      CreateTaskFromTranscript="@CreateTaskFromTranscript"
                                      SendChatDraft="@SendChatDraft"
                                      StopTurn="@StopCurrentTurn"
                                      AttachFiles="@AttachTurnFiles"
                                      RemoveAttachment="@RemoveTurnAttachment"
                                      ClearHistory="@ClearChatHistory"
                                      ShowArchiveConversationPrompt="@showArchiveConversationPrompt"
                                      ArchiveConversationMessage="@archiveConversationMessage"
                                      ArchiveConversationTriggerLabel="@archiveConversationTriggerLabel"
                                      ArchiveConversationMessageCount="@chatMessages.Count"
                                      ArchiveConversationAttachmentCount="@turnAttachments.Count"
                                      ArchiveConversationHasDraft="@(!string.IsNullOrWhiteSpace(chatDraft))"
                                      ArchiveConversationContinueWithoutSavingText="@archiveConversationContinueWithoutSavingText"
                                      ArchiveConversationSaveButtonText="@archiveConversationSaveButtonText"
                                      ArchiveConversationSuggestedName="@archiveConversationSuggestedName"
                                      ArchiveConversationPromptCompleted="@CompleteArchiveConversationPrompt"
                                      ApprovePermission="@ApprovePermissionRequest"
                                      ApprovePermissionForSession="@ApprovePermissionRequestForSession"
                                      ApprovePermissionAlways="@ApprovePermissionRequestAlways"
                                      DenyPermission="@DenyPermissionRequest"
                                      CancelPermission="@CancelPermissionRequest" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Source">
                        <SourceTab Snapshot="@sourceSnapshot"
                                   @bind-Filter="@sourceFilter"
                                   SelectedPath="@selectedSourcePath"
                                   IsRebuildingIndex="@isRebuildingSourceIndex"
                                   ApplyFilter="@ApplySourceFilter"
                                   RebuildIndex="@RebuildSourceIndex"
                                   SelectFile="@SelectSourceFile" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Tests">
                        <SourceTab Snapshot="@testSourceSnapshot"
                                   @bind-Filter="@testSourceFilter"
                                   SelectedPath="@selectedTestSourcePath"
                                   IsRebuildingIndex="@isRebuildingSourceIndex"
                                   ApplyFilter="@ApplyTestSourceFilter"
                                   RebuildIndex="@RebuildSourceIndex"
                                   SelectFile="@SelectTestSourceFile" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </section>
    </main>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-banner">@errorMessage</div>
    }
</section>

@if (isConnectionPanelVisible)
{
    <div class="screen-modal-overlay" role="dialog" aria-modal="true" aria-label="Connection settings">
        <section class="screen-modal-card connection-modal-card">
            <div class="connection-modal-header">
                <div>
                    <span class="connection-modal-eyebrow">Runtime Controls</span>
                    <h2>Connection</h2>
                </div>
                <RadzenButton Icon="close"
                              Text="Close"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@ToggleConnectionPanel" />
            </div>

            <div class="connection-modal-body">
                <ConnectionPanel Snapshot="@snapshot"
                                 Busy="@busy"
                                 McpUrl="@mcpUrl"
                                 WorkspaceRoot="@repoRoot"
                                 WorkflowHistoryPath="@WorkflowHistoryPath"
                                 StatusEvents="@snapshot.StatusEvents"
                                 RawLines="@snapshot.RawLines"
                                 DebugEvents="@DebugEvents"
                                 CurrentEditSessionId="@WorkspaceState.CurrentEditSessionId"
                                 CurrentDeclaredEditFiles="@CurrentDeclaredEditFiles"
                                 QueuedReviewSessionId="@pendingReviewLaunch?.SessionId"
                                 LaunchedReviewSessionId="@launchedReviewSessionId"
                                 ReviewDialogOpen="@reviewDialogOpen"
                                 ReviewLaunchCheckInProgress="@reviewLaunchCheckInProgress"
                                 ReviewLaunchProcessing="@reviewLaunchProcessing"
                                 @bind-CodexExe="@codexExe"
                                 @bind-Model="@model"
                                 @bind-ApprovalPolicy="@approvalPolicy"
                                 @bind-Sandbox="@sandbox"
                                 @bind-TurnMode="@turnMode"
                                 ToggleServer="@ToggleServer" />
            </div>
        </section>
    </div>
}

@if (isRebuildingSourceIndex)
{
    <div class="screen-busy-overlay" role="status" aria-live="polite" aria-label="Rebuilding workspace index">
        <div class="screen-busy-card">
            <div class="screen-busy-spinner" aria-hidden="true"></div>
            <strong>Rebuilding workspace index</strong>
            <span>Source and test views will refresh when indexing completes.</span>
        </div>
    </div>
}

@if (reviewApplyInProgress)
{
    <div class="screen-busy-overlay" role="status" aria-live="polite" aria-label="Applying review decision">
        <div class="screen-busy-card">
            <div class="screen-busy-spinner" aria-hidden="true"></div>
            <strong>@reviewApplyTitle</strong>
            <span>@reviewApplyDetail</span>
        </div>
    </div>
}
