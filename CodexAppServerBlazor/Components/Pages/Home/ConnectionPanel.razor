@using CodexAppServerBlazor.Services.Workflow
@using CodexAppServerBlazor.Services

<aside class="connection-panel" aria-label="Connection controls">
    <section class="connection-notes" aria-label="Runtime notes">
        <p class="panel-warning">Tested primarily with the current default runtime settings. Other configurations have not been verified yet.</p>
        <p class="panel-help">
            These tabs are runtime and workflow diagnostics. The information is accurate, but the presentation is still a work in progress from active debugging and cleanup.
        </p>
        @if (!string.IsNullOrWhiteSpace(WorkflowHistoryPath))
        {
            <p class="panel-help">
                Runtime history and workflow logs live under <code>@WorkflowHistoryPath</code>. Resolved review artifacts are cleaned up automatically, run history is trimmed, and older telemetry logs are pruned.
            </p>
        }
    </section>

    <RadzenTabs RenderMode="TabRenderMode.Client" class="connection-tabs">
        <Tabs>
            <RadzenTabsItem Text="Runtime">
                <section class="connection-section" aria-label="Runtime settings">
                    <div class="settings-panel-grid">
                        <section class="settings-card settings-card-combined">
                            <div class="settings-card-header">
                                <span class="section-eyebrow">Executable, Approval, Model & Sandbox</span>
                            </div>

                            <div class="settings-grid settings-grid-two-column">
                                <label class="field">
                                    <span>Codex executable</span>
                                    <RadzenTextBox Value="@CodexExe" Change="@OnCodexExeChanged" />
                                </label>

                                <label class="field">
                                    <span>Model</span>
                                    <RadzenTextBox Value="@Model" Change="@OnModelChanged" />
                                </label>

                                <label class="field">
                                    <span>Approval</span>
                                    <RadzenDropDown TValue="string"
                                                    Value="@ApprovalPolicy"
                                                    ValueChanged="@OnApprovalPolicyChanged"
                                                    Data="@ApprovalPolicies" />
                                </label>

                                <label class="field">
                                    <span>Sandbox</span>
                                    <RadzenDropDown TValue="string"
                                                    Value="@Sandbox"
                                                    ValueChanged="@OnSandboxChanged"
                                                    Data="@AvailableSandboxes" />
                                </label>
                            </div>
                        </section>

                        <section class="settings-card settings-card-status">
                            <div class="settings-card-header">
                                <span class="section-eyebrow">Turn Mode & Status</span>
                            </div>
                            <div class="settings-grid settings-grid-single">
                                <label class="field">
                                    <span>Turn Mode</span>
                                    <RadzenDropDown TValue="WorkflowTurnMode"
                                        Value="@TurnMode"
                                        ValueChanged="@OnTurnModeChanged"
                                        Data="@TurnModes" />
                                </label>
                            </div>

                            <div class="runtime-status-list runtime-status-grid">
                                <div>
                                    <span>Server</span>
                                    <strong>@(Snapshot.IsServerStarted ? "Running" : "Stopped")</strong>
                                </div>
                                <div>
                                    <span>Thread</span>
                                    <strong>@(Snapshot.ThreadId ?? "Not started")</strong>
                                </div>
                                <div>
                                    <span>Workspace</span>
                                    <strong>@WorkspaceRoot</strong>
                                </div>
                            </div>

                            <div class="actions connection-actions">
                                <RadzenButton Icon="power_settings_new"
                                              Text="@(Snapshot.IsServerStarted ? "Stop Server" : "Start Server")"
                                              ButtonStyle="@(Snapshot.IsServerStarted ? ButtonStyle.Danger : ButtonStyle.Secondary)"
                                              Click="@ToggleServer"
                                              Disabled="@Busy" />
                            </div>
                        </section>
                    </div>
                </section>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Telemetry">
                <section class="connection-section connection-section-compact" aria-label="Token summary">
                    <section class="token-summary token-summary-stack">
                        <div class="token-summary-header">
                            <span>Telemetry</span>
                            <div class="token-summary-inline">
                                <small>@FormatRateSummary()</small>
                            </div>
                        </div>
                        <div class="token-summary-subtitle">Current turn</div>
                        <div class="token-grid">
                            <div>
                                <span>Input</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.InputTokens)</strong>
                            </div>
                            <div>
                                <span>Cached</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.CachedInputTokens)</strong>
                            </div>
                            <div>
                                <span>Output</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.OutputTokens)</strong>
                            </div>
                            <div>
                                <span>Reasoning</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.ReasoningOutputTokens)</strong>
                            </div>
                            <div>
                                <span>Total</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.TotalTokens)</strong>
                            </div>
                            <div>
                                <span>Window</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.CurrentTurn.ModelContextWindow)</strong>
                            </div>
                        </div>
                        <div class="token-summary-subtitle">Declared edit files</div>
                        <div class="token-files">
                            @if (CurrentDeclaredEditFiles.Count == 0)
                            {
                                <small>No declared edit-session files.</small>
                            }
                            else
                            {
                                @foreach (string path in CurrentDeclaredEditFiles)
                                {
                                    <code>@path</code>
                                }
                            }
                        </div>
                        <div class="token-summary-subtitle">Session total</div>
                        <div class="token-grid">
                            <div>
                                <span>Input</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.SessionTotal.InputTokens)</strong>
                            </div>
                            <div>
                                <span>Cached</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.SessionTotal.CachedInputTokens)</strong>
                            </div>
                            <div>
                                <span>Output</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.SessionTotal.OutputTokens)</strong>
                            </div>
                            <div>
                                <span>Reasoning</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.SessionTotal.ReasoningOutputTokens)</strong>
                            </div>
                            <div>
                                <span>Total</span>
                                <strong>@FormatNumber(Snapshot.TelemetrySummary.SessionTotal.TotalTokens)</strong>
                            </div>
                        </div>
                    </section>
                </section>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Status">
                <section class="connection-section connection-section-log" aria-label="Status events">
                    <OutputTab Events="@StatusEvents" EmptyText="No status events yet." />
                </section>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Protocol">
                <section class="connection-section connection-section-log" aria-label="Protocol lines">
                    <RawProtocolTab Lines="@RawLines" EmptyText="No protocol lines yet." />
                </section>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Debug">
                <section class="connection-section connection-section-log" aria-label="Debug events">
                    <ReviewLaunchDebugTab Events="@DebugEvents"
                                          EmptyText="No launch-trace events yet."
                                          CurrentEditSessionId="@CurrentEditSessionId"
                                          QueuedReviewSessionId="@QueuedReviewSessionId"
                                          LaunchedReviewSessionId="@LaunchedReviewSessionId"
                                          ReviewDialogOpen="@ReviewDialogOpen"
                                          ReviewLaunchCheckInProgress="@ReviewLaunchCheckInProgress"
                                          ReviewLaunchProcessing="@ReviewLaunchProcessing" />
                </section>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</aside>

@code {
    [Parameter]
    public required CodexConnectionSnapshot Snapshot { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string McpUrl { get; set; } = string.Empty;

    [Parameter]
    public string WorkspaceRoot { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<CodexOutputEvent> StatusEvents { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> RawLines { get; set; } = [];

    [Parameter]
    public IReadOnlyList<CodexOutputEvent> DebugEvents { get; set; } = [];

    [Parameter]
    public string WorkflowHistoryPath { get; set; } = string.Empty;

    [Parameter]
    public string? CurrentEditSessionId { get; set; }

    [Parameter]
    public IReadOnlyList<string> CurrentDeclaredEditFiles { get; set; } = [];

    [Parameter]
    public string? QueuedReviewSessionId { get; set; }

    [Parameter]
    public string? LaunchedReviewSessionId { get; set; }

    [Parameter]
    public bool ReviewDialogOpen { get; set; }

    [Parameter]
    public bool ReviewLaunchCheckInProgress { get; set; }

    [Parameter]
    public bool ReviewLaunchProcessing { get; set; }

    [Parameter]
    public string CodexExe { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> CodexExeChanged { get; set; }

    [Parameter]
    public string Model { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ModelChanged { get; set; }

    [Parameter]
    public string ApprovalPolicy { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ApprovalPolicyChanged { get; set; }

    [Parameter]
    public string Sandbox { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SandboxChanged { get; set; }

    [Parameter]
    public WorkflowTurnMode TurnMode { get; set; }

    [Parameter]
    public EventCallback<WorkflowTurnMode> TurnModeChanged { get; set; }

    [Parameter]
    public EventCallback ToggleServer { get; set; }

    private Task OnCodexExeChanged(string? value)
    {
        return CodexExeChanged.InvokeAsync(value ?? string.Empty);
    }

    private Task OnModelChanged(string? value)
    {
        return ModelChanged.InvokeAsync(value ?? string.Empty);
    }

    private Task OnApprovalPolicyChanged(string? value)
    {
        return ApprovalPolicyChanged.InvokeAsync(value ?? "on-request");
    }

    private Task OnSandboxChanged(string? value)
    {
        return SandboxChanged.InvokeAsync(value ?? "read-only");
    }

    private async Task OnTurnModeChanged(WorkflowTurnMode value)
    {
        if (value == WorkflowTurnMode.Work
            && !string.Equals(Sandbox, "read-only", StringComparison.Ordinal))
        {
            await SandboxChanged.InvokeAsync("read-only");
        }

        await TurnModeChanged.InvokeAsync(value);
    }

    private static readonly string[] ApprovalPolicies =
    [
        "on-request",
        "untrusted",
        "on-failure",
        "never",
    ];

    private static readonly string[] Sandboxes =
    [
        "read-only",
        "workspace-write",
        "danger-full-access"
    ];

    private IReadOnlyList<string> AvailableSandboxes => TurnMode == WorkflowTurnMode.Work
        ? ["read-only"]
        : Sandboxes;

    private static readonly WorkflowTurnMode[] TurnModes =
    [
        WorkflowTurnMode.Discuss,
        WorkflowTurnMode.Work
    ];

    private string McpEndpointUrl
    {
        get
        {
            if (string.IsNullOrWhiteSpace(McpUrl))
            {
                return "http://localhost:6278";
            }

            return McpUrl.Trim().TrimEnd('/');
        }
    }

    private string McpDisplayUrl => McpEndpointUrl
        .Replace("http://", string.Empty, StringComparison.OrdinalIgnoreCase)
        .Replace("https://", string.Empty, StringComparison.OrdinalIgnoreCase);

    private string McpHealthUrl => $"{McpEndpointUrl}/health";

    private static string FormatNumber(int? value)
    {
        return value.HasValue ? value.Value.ToString("N0") : "-";
    }

    private string FormatRateSummary()
    {
        string primary = FormatPercent(Snapshot.TelemetrySummary.RateLimits.PrimaryUsedPercent);
        string secondary = FormatPercent(Snapshot.TelemetrySummary.RateLimits.SecondaryUsedPercent);
        string plan = string.IsNullOrWhiteSpace(Snapshot.TelemetrySummary.RateLimits.PlanType)
            ? "plan unknown"
            : Snapshot.TelemetrySummary.RateLimits.PlanType;

        return $"{primary} / {secondary} · {plan}";
    }

    private static string FormatPercent(int? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        if (value.Value is < 0 or > 100)
        {
            return $"{value.Value}% raw";
        }

        return $"{value.Value}%";
    }
}
