@using CodexAppServerBlazor.Services
@using CodexAppServerBlazor.Services.Workflow
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json.Nodes
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="assistant-host">
<div class="assistant-layout" @ref="assistantLayout">
    <div class="chat-composer" @ref="chatComposer">
        <div class="attachment-strip">
            <label class="attachment-picker-label" title="Copy files into runtime and attach them to the next turn">
                <span class="attachment-icon">+</span>
                <span>Attach</span>
                @if (!Busy)
                {
                    <InputFile @key="AttachmentPickerKey"
                               class="attachment-picker"
                               OnChange="@AttachFiles"
                               multiple />
                }
            </label>
            <span class="attachment-count">@GetAttachmentCountText()</span>
            @if (Attachments.Count > 0)
            {
                <div class="attachment-chips" aria-label="Attached files">
                    @foreach (CodexTurnAttachment attachment in Attachments)
                    {
                        <span class="attachment-chip" title="@attachment.Path">
                            <span class="attachment-kind">@GetAttachmentKindText(attachment)</span>
                            <span>@attachment.Name</span>
                            <small>@FormatAttachmentSize(attachment.SizeBytes)</small>
                            <button type="button"
                                    title="Remove attachment"
                                    disabled="@Busy"
                                    @onclick="@(() => RemoveAttachment.InvokeAsync(attachment.Path))">x</button>
                        </span>
                    }
                </div>
            }
        </div>
        <div class="assistant-mode-bar">
            <div class="mode-toggle" role="group" aria-label="Global turn mode">
                <button type="button"
                        class="mode-toggle-button @(TurnMode == WorkflowTurnMode.Discuss ? "active" : string.Empty)"
                        disabled="@Busy"
                        @onclick="@(() => ChangeTurnMode(WorkflowTurnMode.Discuss))">Discuss</button>
                <button type="button"
                        class="mode-toggle-button @(TurnMode == WorkflowTurnMode.Work ? "active" : string.Empty)"
                        disabled="@Busy"
                        @onclick="@(() => ChangeTurnMode(WorkflowTurnMode.Work))">Work</button>
            </div>
            <span class="mode-toggle-note">Global runtime mode for the next turn.</span>
            @if (HasPendingRequests)
            {
                <span class="mode-toggle-warning">Action required before the agent can continue.</span>
            }
        </div>
        @if (IsTurnRunning && !HasPendingRequests)
        {
            <div class="assistant-turn-activity" role="status" aria-live="polite">
                <span class="assistant-turn-spinner" aria-hidden="true"></span>
                <div class="assistant-turn-copy">
                    <strong>@GetTurnActivityText()</strong>
                    <span>Current turn is still running.</span>
                </div>
            </div>
        }
        <textarea @ref="chatInput"
                  class="chat-composer-input"
                  @bind="composerDraft"
                  @bind:event="oninput"
                  @bind:after="OnComposerDraftBound"
                  placeholder="Inspect the current workspace..."></textarea>
        <div class="chat-composer-actions">
            <RadzenButton Icon="policy"
                          Text="System Evaluation"
                          Class="chat-prompt-button"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@LoadSystemEvaluationPrompt"
                          Disabled="@Busy" />
            <RadzenButton Icon="send"
                          Text="Submit Turn"
                          Class="chat-send-button"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@SendChatDraft"
                          Disabled="@(!IsServerStarted || Busy || IsTurnRunning || (string.IsNullOrWhiteSpace(composerDraft) && Attachments.Count == 0))" />
            @if (IsTurnRunning)
            {
                <RadzenButton Icon="stop_circle"
                              Text="Stop Turn"
                              Class="chat-stop-button"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@StopTurn"
                              Disabled="@Busy" />
            }
        </div>
    </div>

    <div class="assistant-splitter" @ref="assistantSplitter" title="Drag to resize input and chat history" aria-hidden="true"></div>

    <section class="transcript-panel" @ref="transcriptPanel" aria-label="Completed Codex transcript">
        <div class="transcript-header">
            <span>Chat History</span>
            <div class="transcript-actions">
                <RadzenButton Icon="content_copy"
                              Text="Copy"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@CopyTranscript"
                              Disabled="@(!HasTranscript)" />
                <RadzenButton Icon="open_in_new"
                              Text="Pop Out"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@OpenTranscript"
                              Disabled="@(!HasTranscript)" />
                <RadzenButton Icon="delete_sweep"
                              Text="Start New Conversation"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Title="Starts a fresh conversation by clearing the visible chat, removing pending attachments, and resetting the active Codex thread."
                              Click="@ClearTranscript"
                              Disabled="@(!HasTranscript || Busy || IsTurnRunning)" />
                <RadzenButton Icon="assignment_add"
                              Text="New Task"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Small"
                              Click="@ShowCreateTaskPanel"
                              Disabled="@(!CanCreateTaskFromTranscript)" />
            </div>
        </div>
        @if (HasPendingRequests)
        {
            <div class="permission-waiting-banner">
                Agent is waiting for your approval in <strong>Agent Action Required</strong>.
            </div>
        }
        @if (isCreateTaskPanelVisible)
        {
            <div class="transcript-task-panel">
                <label class="transcript-task-field">
                    <span>Task title</span>
                    <input type="text"
                           value="@taskTitleDraft"
                           placeholder="Promote this discussion into a task..."
                           @oninput="OnTaskTitleInput" />
                </label>
                <div class="transcript-task-actions">
                    <RadzenButton Icon="add_task"
                                  Text="Create In New Task"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@CreateTask"
                                  Disabled="@(!CanSubmitTaskCreation)" />
                    <RadzenButton Icon="close"
                                  Text="Cancel"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@HideCreateTaskPanel"
                                  Disabled="@Busy" />
                </div>
                @if (!IsDiscussMode)
                {
                    <div class="transcript-task-note">Switch to Discuss mode before promoting chat into a new task.</div>
                }
            </div>
        }
        @if (ShowArchiveConversationPrompt)
        {
            <div class="transcript-task-panel archive-prompt-panel">
                <div class="archive-prompt-header">
                    <span>Save Current Conversation?</span>
                    <small>Choose what should happen before we continue.</small>
                </div>
                <ArchiveConversationDialog Message="@ArchiveConversationMessage"
                                           TriggerLabel="@ArchiveConversationTriggerLabel"
                                           MessageCount="@ArchiveConversationMessageCount"
                                           AttachmentCount="@ArchiveConversationAttachmentCount"
                                           HasDraft="@ArchiveConversationHasDraft"
                                           ContinueWithoutSavingText="@ArchiveConversationContinueWithoutSavingText"
                                           SaveButtonText="@ArchiveConversationSaveButtonText"
                                           SuggestedName="@ArchiveConversationSuggestedName"
                                           Completed="@HandleArchiveConversationPrompt" />
            </div>
        }
        <div class="transcript-view"
             @ref="transcriptView"
             role="log"
             aria-label="Completed Codex transcript">
            <div class="transcript-body">@((MarkupString)TranscriptBodyHtml)</div>
        </div>
    </section>

    @if (CurrentVisibleRequest is not null)
    {
        bool isPending = IsPending(CurrentVisibleRequest);
        PermissionRequestDisplayModel presentation = PermissionRequestDisplayFormatter.Build(CurrentVisibleRequest);
        bool hasElicitationForm = PermissionRequestService.IsElicitationRequest(CurrentVisibleRequest.Method)
            && currentElicitationSchema is not null
            && currentElicitationSchema.Fields.Count > 0;
        bool isSimpleBooleanElicitation = IsSimpleBooleanElicitation(currentElicitationSchema);
        <div class="agent-modal-overlay" role="dialog" aria-modal="true" aria-label="Agent action required">
            <section class="agent-modal-card">
                <div class="agent-modal-header">
                    <div>
                        <span class="agent-modal-eyebrow">Agent Action Required</span>
                        <h3>@presentation.Headline</h3>
                    </div>
                    <div class="agent-modal-header-actions">
                        <div class="agent-modal-tab-strip" role="tablist" aria-label="Request detail tabs">
                            <button type="button"
                                    class="agent-modal-tab-button @(showAdvancedRequestDetails ? string.Empty : "active")"
                                    @onclick="@(() => showAdvancedRequestDetails = false)">Action</button>
                            <button type="button"
                                    class="agent-modal-tab-button @(showAdvancedRequestDetails ? "active" : string.Empty)"
                                    @onclick="@(() => showAdvancedRequestDetails = true)">Advanced</button>
                        </div>
                        <div class="agent-modal-status">@GetPendingHeaderText()</div>
                    </div>
                </div>

                <div class="agent-modal-body @(!showAdvancedRequestDetails ? "action-mode" : "advanced-mode")">
                    @if (!showAdvancedRequestDetails)
                    {
                    <section class="agent-modal-main agent-modal-main-full">
                        @if (!string.IsNullOrWhiteSpace(presentation.DetailText))
                        {
                            <div class="agent-modal-section">
                                <span class="agent-modal-label">@(isSimpleBooleanElicitation ? "Question" : presentation.DetailTitle)</span>
                                <pre class="agent-modal-rich-box @(isSimpleBooleanElicitation ? "agent-modal-question-box" : string.Empty)">@presentation.DetailText</pre>
                            </div>
                        }
                        @if (!isSimpleBooleanElicitation)
                        {
                            <div class="agent-modal-section agent-modal-secondary-section">
                                <span class="agent-modal-label">Summary</span>
                                <div class="agent-modal-summary-box">@presentation.Summary</div>
                            </div>
                        }
                        @if (hasElicitationForm)
                        {
                            <div class="agent-modal-section">
                                <span class="agent-modal-label">Answer</span>
                                <div class="agent-modal-form-grid">
                                    @foreach (ElicitationFieldDefinition field in currentElicitationSchema!.Fields)
                                    {
                                        <label class="agent-modal-form-field">
                                            <span class="agent-modal-field-label">@field.Label</span>
                                            @if (!string.IsNullOrWhiteSpace(field.Description))
                                            {
                                                <small>@field.Description</small>
                                            }
                                            @switch (field.Kind)
                                            {
                                                case ElicitationFieldKind.Boolean:
                                                    @if (isSimpleBooleanElicitation)
                                                    {
                                                        <div class="agent-modal-boolean-choice" role="group" aria-label="@field.Label">
                                                            <button type="button"
                                                                    class="agent-modal-choice-button @(GetElicitationBooleanValue(field.Name) ? "selected" : string.Empty)"
                                                                    @onclick="@(() => SetElicitationBooleanValue(field.Name, true))">Yes</button>
                                                            <button type="button"
                                                                    class="agent-modal-choice-button @(!GetElicitationBooleanValue(field.Name) ? "selected" : string.Empty)"
                                                                    @onclick="@(() => SetElicitationBooleanValue(field.Name, false))">No</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox"
                                                               checked="@GetElicitationBooleanValue(field.Name)"
                                                               @onchange="args => OnElicitationBooleanChanged(field.Name, args)" />
                                                    }
                                                    break;
                                                case ElicitationFieldKind.Enum:
                                                    <select value="@GetElicitationTextValue(field.Name)"
                                                            @onchange="args => OnElicitationTextChanged(field.Name, args)">
                                                        @foreach (ElicitationFieldOption option in field.Options)
                                                        {
                                                            <option value="@option.Value">@option.Label</option>
                                                        }
                                                    </select>
                                                    break;
                                                case ElicitationFieldKind.Number:
                                                    <input type="text"
                                                           inputmode="decimal"
                                                           value="@GetElicitationNumberValue(field.Name)"
                                                           @onchange="args => OnElicitationNumberChanged(field.Name, args)" />
                                                    break;
                                                default:
                                                    <textarea rows="3"
                                                              @onchange="args => OnElicitationTextChanged(field.Name, args)">@GetElicitationTextValue(field.Name)</textarea>
                                                    break;
                                            }
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        @if (isPending && !CurrentVisibleRequest.SupportsSessionApproval && !CurrentVisibleRequest.SupportsPersistentApproval)
                        {
                            <div class="agent-modal-note">One-shot response only for this request type.</div>
                        }
                        @if (!isSimpleBooleanElicitation)
                        {
                            <div class="agent-modal-section agent-modal-secondary-section">
                                <span class="agent-modal-label">Request Details</span>
                                <div class="agent-modal-field-grid">
                                    <div class="agent-modal-field">
                                        <span class="agent-modal-field-label">Request Type</span>
                                        <strong>@presentation.KindLabel</strong>
                                    </div>
                                    <div class="agent-modal-field">
                                        <span class="agent-modal-field-label">Method</span>
                                        <code>@CurrentVisibleRequest.Method</code>
                                    </div>
                                    <div class="agent-modal-field">
                                        <span class="agent-modal-field-label">Status</span>
                                        <strong>@GetRequestStatusText(CurrentVisibleRequest)</strong>
                                    </div>
                                    <div class="agent-modal-field">
                                        <span class="agent-modal-field-label">Created</span>
                                        <strong>@GetRequestTimeText(CurrentVisibleRequest)</strong>
                                    </div>
                                    @foreach (PermissionRequestDisplayField field in presentation.Fields)
                                    {
                                        <div class="agent-modal-field">
                                            <span class="agent-modal-field-label">@field.Label</span>
                                            @if (field.IsCode)
                                            {
                                                <code>@field.Value</code>
                                            }
                                            else
                                            {
                                                <strong>@field.Value</strong>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                    }
                    else
                    {
                    <section class="agent-modal-log">
                        <div class="@GetRequestCardClass(CurrentVisibleRequest)">
                            <div class="agent-request-main">
                                <span>@presentation.KindLabel</span>
                                <strong>@presentation.Headline</strong>
                                <code>#@CurrentVisibleRequest.RequestId</code>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(presentation.ArgumentsJson))
                        {
                            <details class="agent-modal-details">
                                <summary>@presentation.ArgumentsTitle</summary>
                                <pre class="agent-modal-payload-box">@presentation.ArgumentsJson</pre>
                            </details>
                        }
                        <details class="agent-modal-details">
                            <summary>Raw request JSON</summary>
                            <pre class="agent-modal-payload-box raw">@presentation.RawJson</pre>
                        </details>
                    </section>
                    }
                </div>

                <div class="agent-modal-footer">
                    @if (isPending)
                    {
                        <RadzenButton Text="@GetApproveButtonText(CurrentVisibleRequest)"
                                      ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Disabled="@(Busy || !CanSubmitCurrentPermission())"
                                      Click="@SubmitCurrentPermissionResponse" />
                        @if (!isSimpleBooleanElicitation && CurrentVisibleRequest.SupportsSessionApproval)
                        {
                            <RadzenButton Text="Allow Session"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Small"
                                          Disabled="@Busy"
                                          Click="@(() => ApprovePermissionForSession.InvokeAsync(CurrentVisibleRequest.RequestId))" />
                        }
                        @if (!isSimpleBooleanElicitation && CurrentVisibleRequest.SupportsPersistentApproval)
                        {
                            <RadzenButton Text="Allow Always"
                                          ButtonStyle="ButtonStyle.Warning"
                                          Size="ButtonSize.Small"
                                          Disabled="@Busy"
                                          Click="@(() => ApprovePermissionAlways.InvokeAsync(CurrentVisibleRequest.RequestId))" />
                        }
                        @if (!isSimpleBooleanElicitation)
                        {
                            <RadzenButton Text="Deny"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Disabled="@Busy"
                                          Click="@(() => DenyPermission.InvokeAsync(CurrentVisibleRequest.RequestId))" />
                            <RadzenButton Text="Cancel Turn"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Disabled="@Busy"
                                          Click="@(() => CancelPermission.InvokeAsync(CurrentVisibleRequest.RequestId))" />
                        }
                    }
                </div>
            </section>
        </div>
    }
</div>
</div>

@code {
    [Parameter]
    public string TranscriptHtml { get; set; } = string.Empty;

    [Parameter]
    public string TranscriptBodyHtml { get; set; } = string.Empty;

    [Parameter]
    public string TranscriptText { get; set; } = string.Empty;

    [Parameter]
    public string CurrentTurnHtml { get; set; } = string.Empty;

    [Parameter]
    public WorkflowTurnMode TurnMode { get; set; }

    [Parameter]
    public EventCallback<WorkflowTurnMode> TurnModeChanged { get; set; }

    [Parameter]
    public IReadOnlyList<CodexPermissionRequest> PermissionRequests { get; set; } = [];

    [Parameter]
    public IReadOnlyList<CodexTurnAttachment> Attachments { get; set; } = [];

    [Parameter]
    public string AttachmentPickerKey { get; set; } = string.Empty;

    [Parameter]
    public string ChatDraft { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ChatDraftChanged { get; set; }

    [Parameter]
    public bool IsServerStarted { get; set; }

    [Parameter]
    public bool IsTurnRunning { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<string> CreateTaskFromTranscript { get; set; }

    [Parameter]
    public EventCallback SendChatDraft { get; set; }

    [Parameter]
    public EventCallback StopTurn { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> AttachFiles { get; set; }

    [Parameter]
    public EventCallback<string> RemoveAttachment { get; set; }

    [Parameter]
    public EventCallback ClearHistory { get; set; }

    [Parameter]
    public bool ShowArchiveConversationPrompt { get; set; }

    [Parameter]
    public string ArchiveConversationMessage { get; set; } = string.Empty;

    [Parameter]
    public string ArchiveConversationTriggerLabel { get; set; } = string.Empty;

    [Parameter]
    public int ArchiveConversationMessageCount { get; set; }

    [Parameter]
    public int ArchiveConversationAttachmentCount { get; set; }

    [Parameter]
    public bool ArchiveConversationHasDraft { get; set; }

    [Parameter]
    public string ArchiveConversationContinueWithoutSavingText { get; set; } = "Continue";

    [Parameter]
    public string ArchiveConversationSaveButtonText { get; set; } = "Save";

    [Parameter]
    public string ArchiveConversationSuggestedName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<ArchiveConversationDialogResult> ArchiveConversationPromptCompleted { get; set; }

    [Parameter]
    public EventCallback<int> DenyPermission { get; set; }

    [Parameter]
    public EventCallback<PermissionApprovalRequest> ApprovePermission { get; set; }

    [Parameter]
    public EventCallback<int> ApprovePermissionForSession { get; set; }

    [Parameter]
    public EventCallback<int> ApprovePermissionAlways { get; set; }

    [Parameter]
    public EventCallback<int> CancelPermission { get; set; }

    private bool HasTranscript => !string.IsNullOrWhiteSpace(TranscriptText);
    private bool HasPendingRequests => PendingRequests.Count > 0;
    private bool IsDiscussMode => TurnMode == WorkflowTurnMode.Discuss;
    private bool CanCreateTaskFromTranscript => HasTranscript && IsDiscussMode && !Busy;
    private bool CanSubmitTaskCreation => CanCreateTaskFromTranscript && !string.IsNullOrWhiteSpace(taskTitleDraft);
    private bool isCreateTaskPanelVisible;
    private string taskTitleDraft = string.Empty;
    private bool showAdvancedRequestDetails;
    private int? elicitationStateRequestId;
    private ElicitationRequestSchema? currentElicitationSchema;
    private readonly Dictionary<string, bool> elicitationBooleanValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> elicitationTextValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> elicitationNumberValues = new(StringComparer.Ordinal);

    private IReadOnlyList<CodexPermissionRequest> PendingRequests =>
        PermissionRequests
            .Where(IsPending)
            .OrderBy(request => request.CreatedAt)
            .ToArray();
    private IReadOnlyList<CodexPermissionRequest> VisibleRequests =>
        CurrentVisibleRequest is null ? [] : [CurrentVisibleRequest];
    private CodexPermissionRequest? CurrentVisibleRequest =>
        PendingRequests.FirstOrDefault();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        SynchronizeElicitationState();

        if (!string.Equals(ChatDraft, composerDraft, StringComparison.Ordinal))
        {
            composerDraft = ChatDraft ?? string.Empty;
        }
    }

    private void ShowCreateTaskPanel()
    {
        isCreateTaskPanelVisible = true;
        if (string.IsNullOrWhiteSpace(taskTitleDraft))
        {
            taskTitleDraft = "Promote current discussion";
        }
    }

    private void HideCreateTaskPanel()
    {
        isCreateTaskPanelVisible = false;
        taskTitleDraft = string.Empty;
    }

    private string GetPendingHeaderText()
    {
        return PendingRequests.Count switch
        {
            0 => "No pending requests",
            _ => "Waiting for you"
        };
    }

    private static bool IsPending(CodexPermissionRequest request)
    {
        return request.Status.Equals("pending", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetRequestCardClass(CodexPermissionRequest request)
    {
        if (IsPending(request))
        {
            return "agent-request-card pending";
        }

        if (request.Status.Contains("approved", StringComparison.OrdinalIgnoreCase))
        {
            return "agent-request-card approved";
        }

        if (request.Status.Contains("denied", StringComparison.OrdinalIgnoreCase) ||
            request.Status.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return "agent-request-card denied";
        }

        return "agent-request-card resolved";
    }

    private static string GetRequestStatusText(CodexPermissionRequest request)
    {
        if (IsPending(request))
        {
            return "Awaiting user decision";
        }

        if (request.Status.Contains("command completed", StringComparison.OrdinalIgnoreCase))
        {
            return "Command completed after approval";
        }

        if (request.Status.Contains("command failed", StringComparison.OrdinalIgnoreCase))
        {
            return "Command failed after approval";
        }

        if (request.Status.Contains("resumed", StringComparison.OrdinalIgnoreCase))
        {
            return "Request resumed after approval";
        }

        if (request.Status.Contains("approved", StringComparison.OrdinalIgnoreCase))
        {
            if (PermissionRequestService.IsElicitationRequest(request.Method))
            {
                return "Elicitation answered - waiting for agent";
            }

            return "Approved - waiting for command result";
        }

        if (request.Status.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return "Cancelled - turn interruption requested";
        }

        if (request.Status.Contains("denied", StringComparison.OrdinalIgnoreCase))
        {
            return "Denied - agent must choose another path";
        }

        return request.Status;
    }

    private static string GetApproveButtonText(CodexPermissionRequest request)
    {
        PermissionRequestDisplayModel display = PermissionRequestDisplayFormatter.Build(request);
        if (display.KindLabel.Equals("MCP Tool Call", StringComparison.OrdinalIgnoreCase))
        {
            return request.SupportsSessionApproval || request.SupportsPersistentApproval
                ? "Allow"
                : "Allow Once";
        }

        if (PermissionRequestService.IsElicitationRequest(request.Method))
        {
            return "Submit Answer";
        }

        return request.SupportsSessionApproval || request.SupportsPersistentApproval
            ? "Allow"
            : "Allow Once";
    }

    private void SynchronizeElicitationState()
    {
        CodexPermissionRequest? request = CurrentVisibleRequest;
        if (request is null)
        {
            ClearElicitationState();
            return;
        }

        if (elicitationStateRequestId == request.RequestId)
        {
            return;
        }

        elicitationStateRequestId = request.RequestId;
        currentElicitationSchema = PermissionRequestService.IsElicitationRequest(request.Method)
            ? ElicitationRequestSchemaParser.Parse(request.RawJson)
            : null;

        elicitationBooleanValues.Clear();
        elicitationTextValues.Clear();
        elicitationNumberValues.Clear();

        if (currentElicitationSchema is null)
        {
            return;
        }

        foreach (ElicitationFieldDefinition field in currentElicitationSchema.Fields)
        {
            switch (field.Kind)
            {
                case ElicitationFieldKind.Boolean:
                    elicitationBooleanValues[field.Name] = field.DefaultBoolean ?? false;
                    break;
                case ElicitationFieldKind.String:
                case ElicitationFieldKind.Enum:
                    elicitationTextValues[field.Name] = field.DefaultText ?? field.Options.FirstOrDefault()?.Value ?? string.Empty;
                    break;
                case ElicitationFieldKind.Number:
                    elicitationNumberValues[field.Name] = field.DefaultNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                    break;
            }
        }
    }

    private void ClearElicitationState()
    {
        elicitationStateRequestId = null;
        currentElicitationSchema = null;
        showAdvancedRequestDetails = false;
        elicitationBooleanValues.Clear();
        elicitationTextValues.Clear();
        elicitationNumberValues.Clear();
    }

    private async Task SubmitCurrentPermissionResponse()
    {
        CodexPermissionRequest? request = CurrentVisibleRequest;
        if (request is null)
        {
            return;
        }

        JsonObject? elicitationContent = null;
        if (PermissionRequestService.IsElicitationRequest(request.Method))
        {
            elicitationContent = BuildElicitationContent();
        }

        await ApprovePermission.InvokeAsync(new PermissionApprovalRequest(request.RequestId, elicitationContent));
    }

    private JsonObject? BuildElicitationContent()
    {
        if (currentElicitationSchema is null || currentElicitationSchema.Fields.Count == 0)
        {
            return null;
        }

        JsonObject content = [];
        foreach (ElicitationFieldDefinition field in currentElicitationSchema.Fields)
        {
            switch (field.Kind)
            {
                case ElicitationFieldKind.Boolean:
                    content[field.Name] = elicitationBooleanValues.TryGetValue(field.Name, out bool boolValue)
                        ? boolValue
                        : field.DefaultBoolean ?? false;
                    break;

                case ElicitationFieldKind.String:
                case ElicitationFieldKind.Enum:
                    if (elicitationTextValues.TryGetValue(field.Name, out string? textValue) &&
                        !string.IsNullOrWhiteSpace(textValue))
                    {
                        content[field.Name] = textValue;
                    }
                    break;

                case ElicitationFieldKind.Number:
                    if (elicitationNumberValues.TryGetValue(field.Name, out string? numberText) &&
                        decimal.TryParse(numberText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out decimal numberValue))
                    {
                        content[field.Name] = numberValue;
                    }
                    break;
            }
        }

        return content;
    }

    private bool CanSubmitCurrentPermission()
    {
        CodexPermissionRequest? request = CurrentVisibleRequest;
        if (request is null || !IsPending(request))
        {
            return false;
        }

        if (!PermissionRequestService.IsElicitationRequest(request.Method) || currentElicitationSchema is null)
        {
            return true;
        }

        foreach (ElicitationFieldDefinition field in currentElicitationSchema.Fields)
        {
            if (!field.IsRequired)
            {
                continue;
            }

            switch (field.Kind)
            {
                case ElicitationFieldKind.Boolean:
                    continue;

                case ElicitationFieldKind.String:
                case ElicitationFieldKind.Enum:
                    if (!elicitationTextValues.TryGetValue(field.Name, out string? textValue) || string.IsNullOrWhiteSpace(textValue))
                    {
                        return false;
                    }
                    break;

                case ElicitationFieldKind.Number:
                    if (!elicitationNumberValues.TryGetValue(field.Name, out string? numberText) ||
                        !decimal.TryParse(numberText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out _))
                    {
                        return false;
                    }
                    break;
            }
        }

        return true;
    }

    private bool GetElicitationBooleanValue(string fieldName)
    {
        return elicitationBooleanValues.TryGetValue(fieldName, out bool value) && value;
    }

    private string GetElicitationTextValue(string fieldName)
    {
        return elicitationTextValues.TryGetValue(fieldName, out string? value) ? value : string.Empty;
    }

    private string GetElicitationNumberValue(string fieldName)
    {
        return elicitationNumberValues.TryGetValue(fieldName, out string? value) ? value : string.Empty;
    }

    private void OnElicitationBooleanChanged(string fieldName, ChangeEventArgs args)
    {
        bool value = args.Value switch
        {
            bool boolValue => boolValue,
            string stringValue when bool.TryParse(stringValue, out bool parsed) => parsed,
            _ => false
        };

        elicitationBooleanValues[fieldName] = value;
    }

    private void SetElicitationBooleanValue(string fieldName, bool value)
    {
        elicitationBooleanValues[fieldName] = value;
    }

    private void OnElicitationTextChanged(string fieldName, ChangeEventArgs args)
    {
        elicitationTextValues[fieldName] = args.Value?.ToString() ?? string.Empty;
    }

    private void OnElicitationNumberChanged(string fieldName, ChangeEventArgs args)
    {
        elicitationNumberValues[fieldName] = args.Value?.ToString() ?? string.Empty;
    }

    private static string GetRequestTimeText(CodexPermissionRequest request)
    {
        DateTimeOffset timestamp = request.ResolvedAt ?? request.CreatedAt;
        return timestamp.ToLocalTime().ToString("HH:mm:ss");
    }

    private static bool IsSimpleBooleanElicitation(ElicitationRequestSchema? schema)
    {
        return schema is not null
            && schema.Fields.Count == 1
            && schema.Fields[0].Kind == ElicitationFieldKind.Boolean;
    }

    private static string GetRequestHeading(CodexPermissionRequest request)
    {
        return PermissionRequestDisplayFormatter.Build(request).Headline;
    }

    private static string GetRequestSummaryText(CodexPermissionRequest request)
    {
        return PermissionRequestDisplayFormatter.Build(request).Summary;
    }

    private static string FormatRequestPayload(CodexPermissionRequest request)
    {
        string payload = string.IsNullOrWhiteSpace(request.RawJson)
            ? request.Summary
            : request.RawJson;

        if (string.IsNullOrWhiteSpace(payload))
        {
            return request.Method;
        }

        try
        {
            using System.Text.Json.JsonDocument document = System.Text.Json.JsonDocument.Parse(payload);
            return System.Text.Json.JsonSerializer.Serialize(
                document.RootElement,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                });
        }
        catch (System.Text.Json.JsonException)
        {
            return payload;
        }
    }

    private static string GetAttachmentKindText(CodexTurnAttachment attachment)
    {
        return attachment.Kind == CodexTurnAttachmentKind.LocalImage
            ? "IMG"
            : "FILE";
    }

    private string GetAttachmentCountText()
    {
        return Attachments.Count switch
        {
            0 => "No files attached",
            1 => "1 file attached",
            _ => $"{Attachments.Count} files attached"
        };
    }

    private static string FormatAttachmentSize(long sizeBytes)
    {
        if (sizeBytes >= 1024L * 1024L)
        {
            return $"{sizeBytes / 1024d / 1024d:0.##} MB";
        }

        if (sizeBytes >= 1024L)
        {
            return $"{sizeBytes / 1024d:0.##} KB";
        }

        return $"{sizeBytes} B";
    }

