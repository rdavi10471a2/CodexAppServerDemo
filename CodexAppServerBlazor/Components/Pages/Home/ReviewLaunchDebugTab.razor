@using CodexAppServerBlazor.Services

<div class="review-debug-shell">
    <section class="review-debug-summary">
        <div class="review-debug-summary-header">Governed Review Launch State</div>
        <div class="review-debug-summary-grid">
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Current Edit Session</span>
                <strong>@DisplayValue(CurrentEditSessionId)</strong>
            </div>
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Queued Review Session</span>
                <strong>@DisplayValue(QueuedReviewSessionId)</strong>
            </div>
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Launched Review Session</span>
                <strong>@DisplayValue(LaunchedReviewSessionId)</strong>
            </div>
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Review Dialog Open</span>
                <strong>@(ReviewDialogOpen ? "Yes" : "No")</strong>
            </div>
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Launch Check Running</span>
                <strong>@(ReviewLaunchCheckInProgress ? "Yes" : "No")</strong>
            </div>
            <div class="review-debug-summary-item">
                <span class="review-debug-label">Launch Processing</span>
                <strong>@(ReviewLaunchProcessing ? "Yes" : "No")</strong>
            </div>
        </div>
    </section>

    <div class="event-grid-shell">
        @if (Events.Count == 0)
        {
            <div class="empty-events">@EmptyText</div>
        }
        else
        {
            <table class="event-grid">
                <thead>
                    <tr>
                        <th class="event-time">Time</th>
                        <th class="event-type">Type</th>
                        <th class="event-status">Status</th>
                        <th class="event-source">Source</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CodexOutputEvent item in Events.OrderByDescending(item => item.Timestamp))
                    {
                        <tr class="@GetRowClass(item)">
                            <td class="event-time">@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td class="event-type">@item.Type</td>
                            <td class="event-status">@(item.Status ?? "-")</td>
                            <td class="event-source">@item.Source</td>
                            <td class="event-detail">@item.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<CodexOutputEvent> Events { get; set; } = [];

    [Parameter]
    public string EmptyText { get; set; } = "No launch-trace events yet.";

    [Parameter]
    public string? CurrentEditSessionId { get; set; }

    [Parameter]
    public string? QueuedReviewSessionId { get; set; }

    [Parameter]
    public string? LaunchedReviewSessionId { get; set; }

    [Parameter]
    public bool ReviewDialogOpen { get; set; }

    [Parameter]
    public bool ReviewLaunchCheckInProgress { get; set; }

    [Parameter]
    public bool ReviewLaunchProcessing { get; set; }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "<none>" : value;
    }

    private static string GetRowClass(CodexOutputEvent item)
    {
        return item.Severity switch
        {
            "error" => "event-row event-error",
            "warning" => "event-row event-warning",
            "success" => "event-row event-success",
            _ => "event-row"
        };
    }
}
